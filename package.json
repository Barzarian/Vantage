{
  "name": "vantage-market-terminal",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "next dev",
    "dev:all": "docker compose up -d --wait postgres && pnpm --parallel --filter vantage-market-terminal --filter @vantage/ibkr-bridge dev",
    "dev:ibkr-bridge": "pnpm --filter @vantage/ibkr-bridge dev",
    "db:migrate": "node db/migrate.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "alerts:worker": "tsx scripts/alerts-worker.ts",
    "alerts:vapid": "web-push generate-vapid-keys"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-query": "latest",
    "@tanstack/react-virtual": "latest",
    "class-variance-authority": "latest",
    "clsx": "latest",
    "drizzle-orm": "latest",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "latest",
    "next": "latest",
    "next-auth": "latest",
    "postgres": "latest",
    "react": "latest",
    "react-dom": "latest",
    "recharts": "latest",
    "tailwind-merge": "latest",
    "web-push": "^3.6.7",
    "zod": "latest",
    "zustand": "latest"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@tailwindcss/postcss": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/web-push": "^3.6.4",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "tailwindcss": "latest",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vitest": "latest"
  }
}
