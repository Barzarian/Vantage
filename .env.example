# Mock runs without credentials. Set to ibkr to use the local IBKR bridge.
MARKET_DATA_PROVIDER=mock

# IB Gateway / TWS socket. Use a unique client ID per bridge process.
IB_HOST=127.0.0.1
IB_PORT=4002
IB_CLIENT_ID=41
IB_MARKET_DATA_TYPE=3
IB_READ_ONLY=true
IB_USE_RTH_EQUITIES=true

# Keep the bridge local/private. Configure the same random secret in the app and bridge.
IBKR_BRIDGE_HOST=127.0.0.1
IBKR_BRIDGE_PORT=8787
IBKR_BRIDGE_URL=http://127.0.0.1:8787
IBKR_BRIDGE_TOKEN=replace-with-a-random-32-character-minimum-secret

DATABASE_URL=postgres://vantage:vantage@127.0.0.1:5433/vantage
AUTH_SECRET=

# Alert delivery: use `openssl rand -base64 32` for the storage encryption key.
ALERTS_ENCRYPTION_KEY=
# Optional Web Push VAPID keys (generate with `pnpm alerts:vapid`).
ALERTS_VAPID_PUBLIC_KEY=
ALERTS_VAPID_PRIVATE_KEY=
ALERTS_VAPID_SUBJECT=mailto:admin@example.com
# Optional email delivery via Resend.
RESEND_API_KEY=
ALERTS_EMAIL_FROM=
